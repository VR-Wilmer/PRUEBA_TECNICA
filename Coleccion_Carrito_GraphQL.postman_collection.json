                  "pm.test('Tiempo de respuesta menor a 1000 ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "pm.test('Sin errores GraphQL', () => pm.expect(body.errors).to.be.undefined);",
                  "",
                  "// Validaciones del cupon removido",
                  "pm.test('couponCode es nulo o vacio', () => pm.expect(cart.couponCode).to.be.oneOf([null, '']));",
                  "pm.test('El descuento es 0', () => pm.expect(cart.discount).to.eql(0));",
                  "pm.test('total restaurado = subtotal', () => pm.expect(Math.abs(cart.total - cart.subtotal)).to.be.below(0.01));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation RemoveCoupon {\n  removeCoupon {\n    items {\n      sku\n      name\n      qty\n      unitPrice\n      lineTotal\n    }\n    subtotal\n    discount\n    total\n    couponCode\n    redeemedCodes\n    currency\n  }\n}",
                "variables": "{}"
              }
            },
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] }
          }
        }
