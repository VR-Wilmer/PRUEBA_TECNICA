              "  method: 'POST',",
              "  header: { 'Content-Type': 'application/json' },",
              "  body: { mode: 'raw', raw: JSON.stringify({ query: 'query { cart { total } }' }) }",
              "}, (err, res) => {",
              "  if (!err) { pm.collectionVariables.set('totalBefore', res.json().data.cart.total); }",
              "});"
            ]
          }
